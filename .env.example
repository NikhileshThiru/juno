# Photon / Spectrum (app.photon.codes → project → Settings, or `bunx photon projects secret`)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Gemini (aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=

# Public URL of the cloudflared quick tunnel (changes every tunnel restart)
PUBLIC_BASE_URL=

# E.164, comma-separated. Only these numbers can run /commands.
ADMIN_NUMBERS=
MOM_NUMBER=
CAREGIVER_NUMBER=

# app = Spectrum mini-app cards; image = PNG + edited text checklist fallback
CARD_MODE=app
PORT=3000
TZ=America/New_York
